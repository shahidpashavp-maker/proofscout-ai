# TinyFish's documented MCP endpoint. Replace only if your deployment provides another endpoint.
TINYFISH_MCP_URL=https://agent.tinyfish.ai/mcp
# Explicit upstream auth mode: oauth (default) or api_key. Modes never fall back to each other.
TINYFISH_AUTH_MODE=oauth
# API-key mode only. Store a real value only in the ignored server-side .env file.
TINYFISH_MCP_TOKEN=
# Register this exact callback URI with TinyFish. Official docs do not describe self-service client registration.
TINYFISH_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/tinyfish/callback
PROOFSCOUT_APP_URL=http://localhost:5173
# Obtain the OAuth client ID and token endpoint auth method from TinyFish after provider-side registration.
TINYFISH_OAUTH_CLIENT_ID=
TINYFISH_OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=
# Set only if TinyFish registers this client as confidential. Keep the value in the ignored .env file.
TINYFISH_OAUTH_CLIENT_SECRET=
PORT=3001
